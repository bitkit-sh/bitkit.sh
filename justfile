set shell := ["sh", "-eu", "-c"]

default:
    @just --list

# Install pinned tools and git hooks
setup:
    mise install
    bunx lefthook@2.2.2 install

# Lint, format check, kit validation, tests
check:
    bun scripts/validate-kit.ts
    bunx oxlint@1.89.0 .
    bunx @biomejs/biome@2.6.3 ci .
    bun test

# Vitest run
test-workers:
    bunx vitest@4.1.12 run

# Serve the site and API locally (cf needs Node 22.18+, not Bun)
dev:
    npx cf@latest dev

# Build and validate without uploading
build:
    npx cf@latest build

# Generate Env types from cloudflare.config.ts and typecheck the Worker
typecheck:
    npx cf@latest workers types
    npx tsc --noEmit

# Search and check domains in your Cloudflare account (read-only)
domains query="":
    sh scripts/find-domain.sh {{query}}

# Temporary Cloudflare preview with a claim link (no login needed)
preview:
    sh scripts/preview-temporary.sh

# Deploy with your own Cloudflare account
deploy:
    bun scripts/validate-kit.ts
    npx cf@latest deploy

# Deploy into the bitkit platform namespace
deploy-tenant:
    sh scripts/deploy-tenant.sh

# Publish the kit to bitkit.sh and print its curl setup command
publish:
    sh scripts/publish-kit.sh

# Lint GitHub workflows
audit-actions:
    actionlint
    zizmor .github/workflows

# Preview the Paperclip company import without applying it
company-preview:
    bunx paperclipai@2026.1023.0 company import ./company --target new --dry-run
